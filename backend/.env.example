# Copy to .env for local dev (docker compose up -d starts postgres+redis on these ports).
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://campuscart:campuscart@localhost:5432/campuscart
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -hex 32 — never reuse this example value.
JWT_SECRET=change-me-to-a-random-64-char-hex-string-before-running-anything-real

CORS_ORIGINS=http://localhost:8081,exp://localhost:8081
GROUP_THRESHOLD_PAISE=20000
GROUP_TTL_MINUTES=60

# Option B only — leave unset to run Option A (peer-to-peer UPI, self-reported payment).
PAYMENT_WEBHOOK_SECRET=

EXPO_PUSH_ENABLED=false

# false for local dev (docker-compose runs a separate `worker` container).
# Set true on hosts with no separate worker process type, e.g. Render free
# plan — see render.yaml.
RUN_WORKERS_INLINE=false
